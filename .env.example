# ---- Core service config ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database ----
# Default: local SQLite file, no server/Docker required (disk-constrained
# local dev - see docs/architecture/adr/ADR-008-local-sqlite-dev.md).
# For production/docker, comment this out and use the Postgres URL below.
DATABASE_URL=sqlite:///./researchmind_dev.db
# DATABASE_URL=postgresql+psycopg://researchmind:changeme@localhost:5432/researchmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=researchmind
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=changeme

# ---- Neo4j (Research Knowledge Graph) ----
# Optional locally: the Gap Analyzer's graph queries are NOT_VERIFIED
# without a running Neo4j instance. Leave unset to skip - the platform
# degrades gracefully (Section 81) rather than failing to start.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-random-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM Provider ----
# If ANTHROPIC_API_KEY is unset, the platform runs with NO LLM provider
# configured. Agents that require LLM reasoning will fail loudly with
# LLM_NOT_CONFIGURED rather than fabricate output. This is intentional
# (see Rule 1-4 / ADR-00X).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Literature sources (no key required) ----
ARXIV_API_BASE=https://export.arxiv.org/api/query
SEMANTIC_SCHOLAR_API_BASE=https://api.semanticscholar.org/graph/v1
CROSSREF_API_BASE=https://api.crossref.org

# ---- Sandbox ----
# "docker" = Tier 1, full isolation (network disabled, cgroup limits,
# non-root, read-only image) - REQUIRED for arbitrary/LLM-authored code.
# "process" = Tier 2, reduced isolation (ADR-009) - only for this
# platform's own reviewed codegen templates, in Docker-unavailable dev
# environments. Never set ALLOW_PROCESS_SANDBOX=true in production.
SANDBOX_BACKEND=docker
ALLOW_PROCESS_SANDBOX=false
SANDBOX_ENABLED=true
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_NETWORK_MODE=none

# ---- Quantum ----
QUANTUM_DEFAULT_BACKEND=aer_simulator
QUANTUM_ALLOW_HARDWARE=false
QUANTUM_HARDWARE_ALLOWLIST=

# ---- Rate limiting (Section 56/87) ----
# Defaults to disabled in app/core/config.py so rapid local dev/test
# traffic is never spuriously throttled - set true for any deployment
# reachable outside a trusted local network.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
